{
  "name": "corveda/php-sandbox",
  "description": "An in-process PHP AST policy-enforcement toolkit for constrained code execution",
  "keywords": ["php", "policy", "sandbox", "parser", "allowlist", "denylist"],
  "type": "library",
  "homepage": "https://phpsandbox.org/",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Elijah Horton",
      "email": "elijah@corveda.com"
    },
    {
      "name": "Corveda, LLC."
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "ext-tokenizer": "*",
    "nikic/php-parser": "^5.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5|^11.5|^12.0"
  },
  "replace": {
    "fieryprophet/php-sandbox": "*"
  },
  "autoload": {
    "files": [
      "src/functions.php"
    ],
    "psr-4": {
      "PHPSandbox\\": "src/"
    }
  },
  "scripts": {
    "test": [
      "vendor/bin/phpunit"
    ],
    "docs:api": [
      "php tools/generate-api.php"
    ]
  }
}
